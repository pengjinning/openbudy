# For electron-builder
# https://github.com/electron-userland/electron-builder/issues/6289#issuecomment-1042620422
shamefully-hoist=true
# For China 🇨🇳 developers，解决node install HTTPError: Response code 404 (Not Found)错误
electron_mirror=https://npmmirror.com/mirrors/electron/
# electron-builder 的 dmg-builder 等工具二进制走官方 releases，避免 npmmirror 缺包 404
electron_builder_binaries_mirror=https://github.com/electron-userland/electron-builder-binaries/releases/download/
# 对于 @flowgram.ai 包，使用官方 npm 注册表
# @flowgram.ai:registry=https://registry.npmjs.org/
